# Netlify response headers for drfakhrahabib.netlify.app
# NOTE: the Content-Security-Policy lists fingerprints (sha256) of the small inline
# scripts in index.html and ur/index.html. If those <script> lines are ever edited,
# the fingerprints here must be updated too, or the edited script will be blocked.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-2GDfThrV5tSnnNTPpKwj/MZFe/EXT4Kr0WocIzkq2l4=' 'sha256-pfgOMgfVZwm2ODyms34QYW9h8EwicylhV77q5LHK8c0='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Font files never change under the same name: cache them for a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and icons: cache for one day (replacements appear within 24 hours)
/images/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
